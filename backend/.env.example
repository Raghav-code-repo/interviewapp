# ========================================================
# DEVPATH INTERVIEW ACADEMY — BACKEND ENVIRONMENT
# Copy this file to `.env` in the same folder and fill in real values.
# `.env` must never be committed to version control.
# ========================================================

NODE_ENV=production
PORT=5000
CORS_ORIGIN=http://localhost:5173

# --- JWT Authentication ---
# REQUIRED IN PRODUCTION. The server refuses to boot when NODE_ENV=production
# and this is unset. Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=devpath-super-secret-jwt-key-2026-production-change-me
JWT_EXPIRES_IN=7d

# --- Supabase / PostgreSQL ---
# Get both values from Supabase: Project Settings -> Data Sources.
#
# DATABASE_URL  -> used by the running app for normal reads/writes.
#                  Use the Session pooler (port 5432) so it works over IPv4.
#                  Note the pooler username includes the project ref.
#
# DIRECT_URL    -> used only by `prisma migrate` to create/alter tables.
#                  Migrations need a direct, non-pooled connection.
#
# Leave DATABASE_URL blank to run without a database. Accounts are then kept in
# an in-process store and are lost on restart; /api/health reports this as
# "database": "in_memory". Values that still contain [YOUR-...] placeholders are
# treated as unset automatically.
#
# If your password contains @ : / ? or #, URL-encode it first:
#   node -e "console.log(encodeURIComponent('your password'))"
DATABASE_URL=
DIRECT_URL=

# How long to wait on a database connection probe before falling back to the
# in-memory store. Useful when a corporate firewall silently drops packets.
DATABASE_PROBE_TIMEOUT_MS=4000

# Password for the seeded admin@devpath.io account (Content Studio access).
# Change this before seeding any real environment.
SEED_ADMIN_PASSWORD=admin12345
