# Frontend environment configuration.
# Copy this file to `.env` in this folder if you need to override the defaults.
#
# VITE_API_URL: base URL for the DevPath API.
# In local development the Vite dev server proxies /api to http://localhost:5000,
# so the default below works without any configuration.
# For production, point this at your deployed backend, e.g.
#   VITE_API_URL=https://devpath-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Enables the client-side safe sandbox used by the coding playground.
VITE_ENABLE_MOCK_SANDBOX=true
