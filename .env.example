# ========================================================
# DEVPATH INTERVIEW ACADEMY — ENVIRONMENT CONFIGURATION
# ========================================================

# --- BACKEND ENVIRONMENT VARIABLES ---
# See backend/.env.example for the documented, commented version.
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# JWT Authentication Secret. Must be overridden in production.
JWT_SECRET=devpath-super-secret-jwt-key-2026-production-change-me
JWT_EXPIRES_IN=7d

# Supabase / PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Leave blank to run with the in-memory store.
DATABASE_URL=
DIRECT_URL=
DATABASE_PROBE_TIMEOUT_MS=4000
SEED_ADMIN_PASSWORD=admin12345

# --- FRONTEND ENVIRONMENT VARIABLES ---
# Base URL of the DevPath API. In local development this is proxied by Vite,
# so the default `/api` works without any configuration.
VITE_API_URL=http://localhost:5000/api
VITE_ENABLE_MOCK_SANDBOX=true
